# LLM — this client works with any OpenAI-compatible endpoint, so pick one:
#
# Option A — Groq (recommended to start: free, no credit card, fast).
#   Get a key at https://console.groq.com/keys
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b            # currently available on Groq
#   # Use another currently available Groq model if you hit rate limits.
#
# Option B — OpenRouter (pay-per-token, wide model choice, cheap options).
#   Get a key at https://openrouter.ai/keys
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=openai/gpt-4o-mini             # or any other OpenRouter model slug
#
# Option C — OpenAI directly.
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# Fill in whichever option you're using below:
LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_SUMMARIZER_MODEL=openai/gpt-oss-120b

# Note: Groq's free tier is rate-limited (roughly 30 requests/min and
# 6,000 tokens/min per model as of writing — check console.groq.com for
# current numbers). A single pipeline run makes ~6-10 LLM calls, so one
# run at a time is comfortably within that. The retry/backoff policy in
# src/utils/retry.py already handles occasional 429s automatically.

# Scraping — https://firecrawl.dev
FIRECRAWL_API_KEY=fc-...

# SEO / SERP data — https://serper.dev (2,500 free searches/month)
SERPER_API_KEY=...

# Images — https://www.pexels.com/api/ (free, no paid tier needed)
PEXELS_API_KEY=...

# Pipeline tuning (defaults shown — usually fine to leave as-is)
MAX_RETRIES=4
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=20.0
SUMMARIZE_TOKEN_THRESHOLD=6000
CHUNK_SIZE_TOKENS=3000
SEO_SCORE_THRESHOLD=0.75
MAX_CRITIQUE_LOOPS=2
CACHE_ENABLED=true
LOG_LEVEL=INFO
JSON_LOGS=true
